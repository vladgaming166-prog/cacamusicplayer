<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/caca_red_soft"
            android:padding="6dp"
            android:text="@string/settings"
            android:textColor="@color/caca_red_dark"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_scan"
            style="@style/CacaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/scan_library" />

        <Button
            android:id="@+id/btn_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme" />

        <Button
            android:id="@+id/btn_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account" />

        <Button
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/caca_red_soft"
            android:padding="6dp"
            android:text="@string/pref_playback"
            android:textColor="@color/caca_red_dark"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/chk_resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resume_on_start" />

        <CheckBox
            android:id="@+id/chk_scan_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_on_start" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/caca_red_soft"
            android:padding="6dp"
            android:text="@string/pref_notifications"
            android:textColor="@color/caca_red_dark"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/chk_notify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_notifications" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/caca_red_soft"
            android:padding="6dp"
            android:text="@string/pref_audio"
            android:textColor="@color/caca_red_dark"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/chk_audio_focus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_focus" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/caca_red_soft"
            android:padding="6dp"
            android:text="@string/pref_online"
            android:textColor="@color/caca_red_dark"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/chk_online"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/online_enabled" />

        <EditText
            android:id="@+id/edit_jamendo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/jamendo_client_id"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edit_catalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/user_catalog_url"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edit_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_url"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_clear_cache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/clear_cache" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_app" />
    </LinearLayout>
</ScrollView>
