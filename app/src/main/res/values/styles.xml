<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Holo-era light theme with a red ActionBar. API 14+. -->
    <style name="AppTheme" parent="@android:style/Theme.Holo.Light.DarkActionBar">
        <item name="android:actionBarStyle">@style/CacaActionBar</item>
        <item name="android:actionBarTabTextStyle">@style/CacaTabText</item>
        <item name="android:actionMenuTextColor">@color/text_on_red</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:windowContentOverlay">@drawable/ab_shadow</item>
        <item name="android:listSeparatorTextViewStyle">@style/CacaListSeparator</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:listPreferredItemHeight">@dimen/list_item_height</item>
        <item name="android:fastScrollThumbDrawable">@drawable/fastscroll_thumb</item>
    </style>

    <style name="AppTheme.Dark" parent="@android:style/Theme.Holo">
        <item name="android:actionBarStyle">@style/CacaActionBar</item>
        <item name="android:actionMenuTextColor">@color/text_on_red</item>
        <item name="android:windowBackground">@color/window_bg_dark</item>
        <item name="android:windowContentOverlay">@drawable/ab_shadow</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
    </style>

    <style name="AppTheme.Classic" parent="@android:style/Theme.Holo.Light">
        <item name="android:actionBarStyle">@style/CacaActionBar.Classic</item>
        <item name="android:windowBackground">@color/panel_white</item>
        <item name="android:windowContentOverlay">@drawable/ab_shadow</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="CacaActionBar" parent="@android:style/Widget.Holo.Light.ActionBar.Solid.Inverse">
        <item name="android:background">@drawable/ab_red</item>
        <item name="android:titleTextStyle">@style/CacaActionBarTitle</item>
        <item name="android:subtitleTextStyle">@style/CacaActionBarSubtitle</item>
        <item name="android:displayOptions">showTitle|homeAsUp|showHome</item>
        <item name="android:icon">@mipmap/ic_launcher</item>
    </style>

    <style name="CacaActionBar.Classic" parent="@android:style/Widget.Holo.Light.ActionBar.Solid">
        <item name="android:background">@drawable/ab_red</item>
        <item name="android:titleTextStyle">@style/CacaActionBarTitle</item>
        <item name="android:icon">@mipmap/ic_launcher</item>
    </style>

    <style name="CacaActionBarTitle" parent="@android:style/TextAppearance.Holo.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_on_red</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CacaActionBarSubtitle" parent="@android:style/TextAppearance.Holo.Widget.ActionBar.Subtitle">
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CacaTabText" parent="@android:style/Widget.Holo.Light.ActionBar.TabText">
        <item name="android:textColor">@color/text_on_red</item>
    </style>

    <style name="CacaListSeparator" parent="@android:style/Widget.Holo.Light.TextView">
        <item name="android:background">@color/caca_red_soft</item>
        <item name="android:textColor">@color/caca_red_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="CacaButton" parent="@android:style/Widget.Holo.Light.Button">
        <item name="android:background">@drawable/btn_red</item>
        <item name="android:textColor">@color/text_on_red</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="CacaHomeTitle">
        <item name="android:textColor">@color/caca_red</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
