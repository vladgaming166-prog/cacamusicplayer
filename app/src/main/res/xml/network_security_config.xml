<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS by default. Cleartext is allowed so a user-owned LAN catalog
         (http://192.168.x.x) can work. Do not use this for protected services. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
